# Required for the LLM stages (vision extraction + variance classification + rerank).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Without it the dense half of hybrid search uses the built-in
# deterministic hashing embedder (see app/retrieve.py). BM25 is unaffected.
VOYAGE_API_KEY=
